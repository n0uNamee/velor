# Example only. The backend does not automatically read .env files.
# Set server-side environment variables through your chosen local secret mechanism.
VELOR_ENV=development
VELOR_MODE=demo
VELOR_DEV_AUTH=1
# TELEGRAM_BOT_TOKEN=
# VELOR_TELEGRAM_ALLOWED_USER_IDS=
# OPENROUTER_API_KEY=
VELOR_OPENROUTER_BRIEF_MODEL=google/gemini-3.8-flash
VELOR_OPENROUTER_RENDER_MODEL=google/gemini-3.1-flash-image
# All paid calls remain disabled. A key alone cannot enable spending.
VELOR_ALLOW_PAID_REQUESTS=0
VELOR_PROVIDER_BUDGET_USD=0
# Set reservations only after checking current model price and approved ceiling.
VELOR_ANALYSIS_RESERVE_USD=0
VELOR_RENDER_RESERVE_USD=0
