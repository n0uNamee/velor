# Documentation only. The module does not load .env or discover credentials.
# Integrator passes server-side config explicitly. Never expose these in frontend.
OPENROUTER_API_KEY=
VELOR_STYLIST_MODEL=google/gemini-3.8-flash
VELOR_RENDER_MODEL=google/gemini-3.1-flash-image
# Paid calls remain disabled until user approval AND a shared BudgetGuard exists.
VELOR_STYLIST_PAID_ACTION_APPROVED=false
VELOR_RENDER_PAID_ACTION_APPROVED=false
VELOR_STYLIST_MAX_CALLS=0
VELOR_RENDER_MAX_CALLS=0
